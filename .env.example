# Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
WEB_PORT=3000

# Database and queue
DATABASE_URL=postgresql+asyncpg://opportunity:opportunity@postgres:5432/opportunity_os
REDIS_URL=redis://redis:6379/0

# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# External services — leave blank until configured
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,anthropic/claude-3.5-haiku
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
NEAR_DUPLICATE_HAMMING_THRESHOLD=3
SEMANTIC_DUPLICATE_THRESHOLD=0.94
PROCESSING_BATCH_SIZE=25
CLUSTERING_BATCH_SIZE=50
CLUSTER_SEMANTIC_THRESHOLD=0.86
CLUSTER_HIGH_CONFIDENCE_THRESHOLD=0.92
OPPORTUNITY_BATCH_SIZE=25
HYPOTHESIS_MIN_SIGNAL_COUNT=2
HYPOTHESIS_MIN_SOURCES=2
HYPOTHESIS_MIN_EVIDENCE_TYPES=2
HYPOTHESIS_MIN_RECURRENCE=0.5
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_REDDIT_ACTOR_ID=
APIFY_WEB_COLLECTOR_ACTOR_ID=
APIFY_RESEARCH_ACTOR_ID=
APIFY_SEARCH_DISCOVERY_ACTOR_ID=apify/google-search-scraper
RESEARCH_BATCH_SIZE=10
RESEARCH_MIN_DOCUMENTS_PER_LANE=3
RESEARCH_MAX_DOCUMENTS_PER_LANE=40
MODEL_RETRY_LIMIT=3
COLLECTION_RECONCILE_BATCH_SIZE=20
DECISION_BATCH_SIZE=10
DECISION_ADVANCE_THRESHOLD=70
DECISION_KILL_THRESHOLD=40
DECISION_MIN_CONFIDENCE=0.65
VALIDATION_BATCH_SIZE=10
VALIDATION_MIN_OUTREACH_SAMPLE=50
VALIDATION_STRONG_POSITIVE_RATE=0.05
VALIDATION_WEAK_POSITIVE_RATE=0.02
VALIDATION_MIN_PAIN_CONFIRMATIONS=3
CALIBRATION_MIN_SAMPLES=10
CALIBRATION_MAX_WEIGHT_DELTA=0.02
FRESHNESS_BATCH_SIZE=10
FRESHNESS_DEFAULT_DAYS=60
FRESHNESS_TOP_OPPORTUNITY_DAYS=21
PORTFOLIO_HIGH_SCORE_THRESHOLD=80
PORTFOLIO_SCORE_CHANGE_THRESHOLD=8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APIFY_WEBHOOK_SECRET=change-me
APIFY_WEBHOOK_URL=
